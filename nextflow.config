manifest {
    name = 'IgAN-Flow'
    version = '1.0.0'
    nextflowVersion = '=26.04.6'
}
params {
    input = "${projectDir}/assets/samplesheet.csv"
    settings = "${projectDir}/assets/qc_real.json"
    cache = "${System.getenv('IGAN_CACHE')}"
    synthetic = false
    sample_id = ''
    run_key = 'full/main'
    runtime_manifest = ''
}
process {
    executor = 'local'
    cache = 'deep'
    cpus = 1
    memory = '1 GB'
    time = '2h'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']
    withLabel: heavy {
        cpus = 4
        memory = '12 GB'
        maxForks = 1
    }
}
executor {
    cpus = 4
    memory = '16 GB'
    queueSize = 4
}
profiles {
    local { includeConfig 'conf/local.config' }
    test { includeConfig 'conf/test.config' }
}
trace {
    fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,read_bytes,write_bytes'
}
